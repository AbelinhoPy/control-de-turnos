# =========================================================
# Control de Turnos 24/7 - Variables de Entorno de Ejemplo
# =========================================================

# Modo Demostración (Opcional - solo para pruebas sin Neon Postgres)
# true: Habilita datos ficticios en memoria para demos rápidas sin conexión a base de datos.
# false: Exige conexión real a Neon Postgres (DATABASE_URL obligatoria).
ENABLE_DEMO_MODE="false"

# Base de datos (Neon Postgres Serverless)
# Formato: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_SECRET_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Autenticación y Sesiones
# Generar una clave secreta fuerte de 32+ caracteres (ej: openssl rand -base64 32)
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars-long"
SESSION_COOKIE_NAME="control_turnos_session"

# Zona horaria oficial del sistema
APP_TIMEZONE="America/Asuncion"

# Configuración de Correo Transaccional (Resend / SMTP)
RESEND_API_KEY="re_sample_123456789"
EMAIL_FROM="Control de Turnos <notificaciones@tuempresa.com.py>"

# URL base pública de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sede de trabajo inicial (coordenadas GPS de la empresa y radio de tolerancia en metros)
NEXT_PUBLIC_DEFAULT_WORKPLACE_NAME="Sede Operativa - Minga Guazú"
NEXT_PUBLIC_DEFAULT_WORKPLACE_LAT="-25.496469"
NEXT_PUBLIC_DEFAULT_WORKPLACE_LNG="-54.789641"
NEXT_PUBLIC_DEFAULT_GEOFENCE_RADIUS_METERS="300"
